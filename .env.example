# Copy to .env locally. There are deliberately no usable or dummy passwords here.
# Generate a unique strong database password. Set both values below before Compose starts.
POSTGRES_DB=opsbridge
POSTGRES_USER=opsbridge
POSTGRES_PASSWORD=
# SQLAlchemy URL: postgresql+psycopg://<POSTGRES_USER>:<URL-encoded-password>@db:5432/<POSTGRES_DB>
# Fill this locally; URL-encode reserved characters in the password (not POSTGRES_PASSWORD).
DATABASE_URL=

# Localhost HTTP only: cookies are HTTP-only, SameSite=Strict; Secure=false allows local HTTP.
# This mode is local development, not a production deployment.
APP_ENV=development
PUBLIC_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
# Optional in local development; production requires a valid Fernet key.
# Generate with Python: from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())
FIELD_ENCRYPTION_KEY=
WEB_BIND=127.0.0.1
WEB_PORT=8080

# Production: APP_ENV=production, PUBLIC_ORIGIN=https://your-exact-host (no path),
# COOKIE_SECURE=true. Terminate TLS at your trusted reverse proxy in front of web,
# preserve the original Host and Origin, and keep API/database ports unpublished.
# Match PUBLIC_ORIGIN to the browser-facing origin including any non-default port.
# Do not expose HTTP directly or set COOKIE_SECURE=false in production.
# PostgreSQL data, evidence and sessions persist in the postgres_data named volume.
# Back up that volume; changing .env's password does not rotate an initialized DB password.
# Device drafts/assets can be encrypted only after the user explicitly creates a
# browser vault with a separate passphrase. Offline sign-in, approvals, evidence
# upload and workflow mutations remain disabled; server authorization stays online.
